# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Backend selector ──────────────────────────────────────────────────────
# "claude"   (default) — use Anthropic Claude API directly
# "openclaw"           — read model config from ~/.openclaw/openclaw.json
# LLM_BACKEND=claude

# ── Required: SEC EDGAR ───────────────────────────────────────────────────────

# SEC EDGAR requires a descriptive User-Agent on all HTTP requests.
# Format: "Your Name your@email.com" or "YourCompany/1.0 contact@company.com"
EDGAR_USER_AGENT=YourName your@email.com

# ── Required when LLM_BACKEND=claude ─────────────────────────────────────────

# Anthropic API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Required when LLM_BACKEND=openclaw ───────────────────────────────────────

# The model "id" as defined in your ~/.openclaw/openclaw.json providers section.
# Example: OPENCLAW_MODEL_ID=hf:zai-org/GLM-4.7
# Run `python -c "from src.openclaw_config import list_available_models; [print(m['id'], '-', m['name']) for m in list_available_models()]"`
# to list all models defined in your openclaw.json.
# OPENCLAW_MODEL_ID=your-model-id-here

# Optional: override openclaw.json path (defaults to ~/.openclaw/openclaw.json)
# OPENCLAW_CONFIG_PATH=/custom/path/to/openclaw.json
# OPENCLAW_STATE_DIR=~/.openclaw

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# How many calendar days back to look for filings (default: 1 = yesterday to today)
# EDGAR_DAYS_BACK=1

# Max filings fetched per form type per run (default: 40)
# EDGAR_MAX_PER_FORM=40

# Max tokens for Claude analysis response (default: 4096)
# MAX_ANALYSIS_TOKENS=4096

# Delay in seconds between Claude API calls to avoid rate limits (default: 0.5)
# ANALYSIS_DELAY_SECS=0.5

# Whether to download and analyze the actual filing text (default: true)
# Set to false to analyze from metadata only (faster, cheaper, less accurate)
# FETCH_FILING_TEXT=true

# Max characters of filing text to send to Claude (default: 50000 ≈ ~12k tokens)
# MAX_TEXT_CHARS=50000

# Directory where output JSON/CSV files are saved (default: output/)
# OUTPUT_DIR=output
